# Third-party dependencies for scan_register modules.

include(ScanRegisterHelpers)

find_package(Threads REQUIRED)
# Eigen 5.x Config uses SameMajorVersion; requesting "3.3" rejects 5.x. Require >= 3.3 manually.
find_package(Eigen3 REQUIRED NO_MODULE)
if(Eigen3_VERSION VERSION_LESS 3.3)
  message(FATAL_ERROR "Eigen3 >= 3.3 required, found ${Eigen3_VERSION}")
endif()
find_package(Ceres REQUIRED)
find_package(TBB REQUIRED)
find_package(OpenMP)

find_package(PCL REQUIRED COMPONENTS common registration io search features keypoints filters surface)
if(NOT TARGET pcl_common AND TARGET PCL::common)
  add_library(pcl_common ALIAS PCL::common)
endif()
if(NOT TARGET pcl_registration AND TARGET PCL::registration)
  add_library(pcl_registration ALIAS PCL::registration)
endif()
if(NOT TARGET pcl_io AND TARGET PCL::io)
  add_library(pcl_io ALIAS PCL::io)
endif()
if(NOT TARGET pcl_search AND TARGET PCL::search)
  add_library(pcl_search ALIAS PCL::search)
endif()
if(NOT TARGET pcl_features AND TARGET PCL::features)
  add_library(pcl_features ALIAS PCL::features)
endif()
if(NOT TARGET pcl_keypoints AND TARGET PCL::keypoints)
  add_library(pcl_keypoints ALIAS PCL::keypoints)
endif()
if(NOT TARGET pcl_surface AND TARGET PCL::surface)
  add_library(pcl_surface ALIAS PCL::surface)
endif()
# Older PCL CMake packages expose component vars but no imported target named pcl_io/pcl_search/pcl_features.
if(NOT TARGET pcl_io)
  if(PCL_IO_LIBRARIES)
    add_library(pcl_io INTERFACE)
    target_link_libraries(pcl_io INTERFACE ${PCL_IO_LIBRARIES})
    if(PCL_INCLUDE_DIRS)
      target_include_directories(pcl_io INTERFACE ${PCL_INCLUDE_DIRS})
    endif()
  else()
    message(FATAL_ERROR "PCL io component found but no usable pcl_io / PCL::io target")
  endif()
endif()
if(NOT TARGET pcl_search)
  if(PCL_SEARCH_LIBRARIES)
    add_library(pcl_search INTERFACE)
    target_link_libraries(pcl_search INTERFACE ${PCL_SEARCH_LIBRARIES})
    if(PCL_INCLUDE_DIRS)
      target_include_directories(pcl_search INTERFACE ${PCL_INCLUDE_DIRS})
    endif()
  else()
    message(FATAL_ERROR "PCL search component found but no usable pcl_search / PCL::search target")
  endif()
endif()
if(NOT TARGET pcl_features)
  if(PCL_FEATURES_LIBRARIES)
    add_library(pcl_features INTERFACE)
    target_link_libraries(pcl_features INTERFACE ${PCL_FEATURES_LIBRARIES})
    if(PCL_INCLUDE_DIRS)
      target_include_directories(pcl_features INTERFACE ${PCL_INCLUDE_DIRS})
    endif()
  else()
    message(FATAL_ERROR "PCL features component found but no usable pcl_features / PCL::features target")
  endif()
endif()
if(NOT TARGET pcl_keypoints)
  if(PCL_KEYPOINTS_LIBRARIES)
    add_library(pcl_keypoints INTERFACE)
    target_link_libraries(pcl_keypoints INTERFACE ${PCL_KEYPOINTS_LIBRARIES})
    if(PCL_INCLUDE_DIRS)
      target_include_directories(pcl_keypoints INTERFACE ${PCL_INCLUDE_DIRS})
    endif()
  else()
    message(FATAL_ERROR "PCL keypoints component found but no usable pcl_keypoints / PCL::keypoints target")
  endif()
endif()
if(NOT TARGET pcl_surface)
  if(PCL_SURFACE_LIBRARIES)
    add_library(pcl_surface INTERFACE)
    target_link_libraries(pcl_surface INTERFACE ${PCL_SURFACE_LIBRARIES})
    if(PCL_INCLUDE_DIRS)
      target_include_directories(pcl_surface INTERFACE ${PCL_INCLUDE_DIRS})
    endif()
  else()
    message(FATAL_ERROR "PCL surface component found but no usable pcl_surface / PCL::surface target")
  endif()
endif()

# PDAL removed from point_cloud_io (slow path); may be re-added later for .laz / exotic LAS.

# RapidJSON (header-only). Prefer CMake package (vcpkg RapidJSONConfig) then fall back to find_path.
find_package(RapidJSON QUIET)
if(RapidJSON_FOUND AND DEFINED RAPIDJSON_INCLUDE_DIRS)
  set(SCAN_REGISTER_RAPIDJSON_INCLUDE "${RAPIDJSON_INCLUDE_DIRS}")
else()
  find_path(SCAN_REGISTER_RAPIDJSON_INCLUDE
    NAMES rapidjson/document.h
    PATH_SUFFIXES include
  )
endif()
if(NOT SCAN_REGISTER_RAPIDJSON_INCLUDE)
  message(FATAL_ERROR "RapidJSON not found (need rapidjson/document.h)")
endif()

# OpenCV. Prefer opencv_world when present (vcpkg/MSVC);
# otherwise synthesize an INTERFACE target from core/imgproc/imgcodecs.
find_package(OpenCV REQUIRED COMPONENTS core imgproc imgcodecs)
if(NOT TARGET opencv_world)
  add_library(opencv_world INTERFACE)
  if(TARGET opencv_core AND TARGET opencv_imgproc AND TARGET opencv_imgcodecs)
    target_link_libraries(opencv_world INTERFACE opencv_core opencv_imgproc opencv_imgcodecs)
  else()
    target_link_libraries(opencv_world INTERFACE ${OpenCV_LIBS})
  endif()
  if(OpenCV_INCLUDE_DIRS)
    target_include_directories(opencv_world INTERFACE ${OpenCV_INCLUDE_DIRS})
  endif()
endif()

find_package(spdlog REQUIRED)
get_target_property(_spdlog_inc spdlog::spdlog INTERFACE_INCLUDE_DIRECTORIES)
if(_spdlog_inc)
  list(GET _spdlog_inc 0 SCAN_REGISTER_SPDLOG_INCLUDE)
else()
  set(SCAN_REGISTER_SPDLOG_INCLUDE "")
endif()
unset(_spdlog_inc)

if(NOT TARGET scan_register_spdlog)
  add_library(scan_register_spdlog INTERFACE)
  add_library(scan_register_spdlog::scan_register_spdlog ALIAS scan_register_spdlog)
  target_link_libraries(scan_register_spdlog INTERFACE spdlog::spdlog)
  if(SCAN_REGISTER_SPDLOG_INCLUDE)
    target_include_directories(scan_register_spdlog INTERFACE
      "$<BUILD_INTERFACE:${SCAN_REGISTER_SPDLOG_INCLUDE}>"
    )
  endif()
endif()

# FLANN: vcpkg provides flann-config.cmake; Ubuntu often has no CMake package.
find_package(flann QUIET)
if(NOT TARGET flann::flann_cpp)
  find_path(FLANN_INCLUDE_DIR NAMES flann/flann.hpp)
  find_library(FLANN_CPP_LIBRARY NAMES flann_cpp flann_cpp_s)
  if(NOT FLANN_INCLUDE_DIR OR NOT FLANN_CPP_LIBRARY)
    message(FATAL_ERROR "FLANN not found (need flann/flann.hpp and libflann_cpp)")
  endif()
  add_library(flann::flann_cpp UNKNOWN IMPORTED)
  set_target_properties(flann::flann_cpp PROPERTIES
    IMPORTED_LOCATION "${FLANN_CPP_LIBRARY}"
    INTERFACE_INCLUDE_DIRECTORIES "${FLANN_INCLUDE_DIR}"
  )
  find_library(LZ4_LIBRARY NAMES lz4)
  if(LZ4_LIBRARY)
    set_property(TARGET flann::flann_cpp APPEND PROPERTY
      INTERFACE_LINK_LIBRARIES "${LZ4_LIBRARY}")
  endif()
endif()

# Optional extra include roots for third-party headers (empty by default).
if(NOT DEFINED SCAN_REGISTER_THIRDPARTY_INCLUDES)
  set(SCAN_REGISTER_THIRDPARTY_INCLUDES "")
endif()

message(STATUS "Dependencies:")
message(STATUS "  Eigen3  : ${Eigen3_VERSION}")
message(STATUS "  Ceres   : ${Ceres_VERSION}")
message(STATUS "  TBB     : found")
message(STATUS "  PCL     : ${PCL_VERSION}")
message(STATUS "  PDAL    : not linked (removed from point_cloud_io)")
message(STATUS "  RapidJSON: ${SCAN_REGISTER_RAPIDJSON_INCLUDE}")
message(STATUS "  OpenCV  : ${OpenCV_VERSION}")
message(STATUS "  spdlog  : found")
message(STATUS "  FLANN   : found")
if(OpenMP_CXX_FOUND)
  message(STATUS "  OpenMP  : ${OpenMP_CXX_VERSION}")
else()
  message(STATUS "  OpenMP  : not found")
endif()
