{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-vs2026-vcpkg",
      "displayName": "Windows VS 2026 + vcpkg",
      "description": "Visual Studio 18 2026 (x64), third-party libs via VCPKG_ROOT. Requires CMake >= 4.2.",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "$penv{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_MANIFEST_MODE": "OFF",
        "SCAN_REGISTER_BUILD_ROS2": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-clangd-vcpkg",
      "displayName": "Windows Ninja (clangd / compile_commands)",
      "description": "Ninja Multi-Config + classic vcpkg; exports compile_commands.json for clangd. Prefer scripts/gen_compile_commands.ps1 (forces VCPKG_ROOT after VsDevCmd).",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-clangd",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "D:/install/vcpkg/scripts/buildsystems/vcpkg.cmake"
        },
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_MANIFEST_MODE": "OFF",
        "SCAN_REGISTER_BUILD_ROS2": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-release",
      "displayName": "Windows Release",
      "configurePreset": "windows-vs2026-vcpkg",
      "configuration": "Release"
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug",
      "configurePreset": "windows-vs2026-vcpkg",
      "configuration": "Debug"
    }
  ]
}
